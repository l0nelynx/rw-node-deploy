FROM {{ item.image }}

ENV container=docker
STOPSIGNAL SIGRTMIN+3

RUN if [ -f /etc/debian_version ]; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        systemd systemd-sysv python3 python3-apt sudo ca-certificates curl gnupg \
        git unzip zip openssl nftables iproute2 iputils-ping procps kmod && \
      apt-get clean && rm -rf /var/lib/apt/lists/*; \
    else \
      dnf -y install --allowerasing systemd python3 sudo ca-certificates curl gnupg2 git unzip zip \
        openssl nftables iproute iputils procps-ng kmod && dnf clean all; \
    fi && \
    (systemctl mask dev-hugepages.mount sys-fs-fuse-connections.mount \
      systemd-remount-fs.service getty@.service console-getty.service || true)

VOLUME ["/sys/fs/cgroup"]
CMD ["/sbin/init"]
