ssl_certificate /etc/nginx/certs/fullchain.crt;
ssl_certificate_key /etc/nginx/certs/private.key;
include /etc/nginx/conf.d/includes/ssl-params.conf;
server {
    listen 80;
    server_name .{{ main_domain }};
    return 301 https://$host$request_uri;
}
server {
    listen 8443 ssl proxy_protocol;
    server_name {{ main_domain }};
    location / {
        return 403 "Access Denied";
    }
}
server {
    listen unix:/dev/shm/reality.socket ssl proxy_protocol;
	server_name *.{{ main_domain }};
	ssl_certificate "/etc/nginx/certs/fullchain.crt";
	ssl_certificate_key "/etc/nginx/certs/private.key";
	ssl_trusted_certificate "/etc/nginx/certs/fullchain.crt";
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ecdh_curve X25519:prime256v1:secp384r1;
	ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;
	ssl_prefer_server_ciphers on;
	ssl_session_timeout 1d;
	ssl_session_cache shared:MozSSL:10m;
	ssl_session_tickets off;
    root /usr/share/nginx/html;
    index index.html index.htm;
	add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;

}

server {
    listen unix:/dev/shm/reality.socket ssl proxy_protocol default_server;
    server_name _;
    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen unix:/dev/shm/nginx_fallback.socket proxy_protocol;
	server_name *.{{ main_domain }};
	http2 on;
    root /usr/share/nginx/html;
    index index.html index.htm;
	add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
}